# ---------------------------------------------------------------------------
# Field Service Tracker — ignore rules
# Generated Dart code (*.g.dart, lib/l10n/app_localizations*.dart) IS committed
# on purpose; CI regenerates it and fails if it is out of date.
# ---------------------------------------------------------------------------

# Miscellaneous
*.class
*.log
*.pyc
*.swp
*.tmp
.DS_Store
Thumbs.db
desktop.ini
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code: keep shared recommendations only
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json

# Flutter / Dart / Pub
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/
.widget_preview/

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Android build output & machine-specific files
/android/app/debug
/android/app/profile
/android/app/release
/android/app/.cxx/
/android/build/
/android/.gradle/
/android/.kotlin/
/android/local.properties
/android/captures/
*.apk
*.aab

# Signing material & secrets — never commit
*.jks
*.keystore
key.properties
/android/key.properties
.env
.env.*
*.pem
*.p12
secrets.*
google-services.json

# Local databases
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
