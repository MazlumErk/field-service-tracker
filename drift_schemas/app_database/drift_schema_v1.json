  "fixed_sql": [
    {
      "name": "customers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"customers\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"customer_number\" TEXT NOT NULL, \"first_name\" TEXT NOT NULL, \"last_name\" TEXT NOT NULL, \"phone\" TEXT NULL, \"address\" TEXT NULL, \"search_key\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, UNIQUE (\"customer_number\"), CHECK (length(trim(first_name)) > 0), CHECK (length(trim(last_name)) > 0));"
        }
      ]
    },
    {
      "name": "devices",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"devices\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"customer_id\" INTEGER NOT NULL REFERENCES customers (id) ON UPDATE RESTRICT ON DELETE RESTRICT, \"model\" TEXT NOT NULL, \"serial_number\" TEXT NULL, \"installed_at\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, CHECK (length(trim(model)) > 0));"
        }
      ]
    },
    {
      "name": "maintenance_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"maintenance_records\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"device_id\" INTEGER NOT NULL REFERENCES devices (id) ON UPDATE RESTRICT ON DELETE RESTRICT, \"maintenance_date\" TEXT NOT NULL, \"next_maintenance_date\" TEXT NOT NULL, \"price_kurus\" INTEGER NOT NULL, \"notes\" TEXT NULL, \"created_at\" INTEGER NOT NULL, CHECK (price_kurus >= 0), CHECK (next_maintenance_date >= maintenance_date));"
        }
      ]
    },
    {
      "name": "filter_replacements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"filter_replacements\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"maintenance_record_id\" INTEGER NOT NULL REFERENCES maintenance_records (id) ON UPDATE RESTRICT ON DELETE RESTRICT, \"filter_type\" TEXT NOT NULL, UNIQUE (\"maintenance_record_id\", \"filter_type\"));"
        }
      ]
    },
    {
